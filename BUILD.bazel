load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Gazelle writes the BUILD files from the Go sources; these directives are the
# only hand-written part.
#
# The generated Go in protobuf/generated is committed, so no proto rules: the
# .proto files are buf's input, not Bazel's.
# gazelle:prefix github.com/shokki-engineering/freebusy
# gazelle:proto disable_global
# gazelle:go_naming_convention import
# gazelle:exclude hasura
# gazelle:exclude docker
# gazelle:exclude .claude
gazelle(name = "gazelle")

go_library(
    name = "freebusy_lib",
    srcs = [
        "app.go",
        "main.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy",
    visibility = ["//visibility:private"],
    deps = [
        "//config",
        "//internal",
        "//shared",
        "@com_github_joho_godotenv//autoload",
        "@org_golang_x_crypto_x509roots_fallback//:fallback",
    ],
)

go_binary(
    name = "freebusy",
    embed = [":freebusy_lib"],
    visibility = ["//visibility:public"],
)
