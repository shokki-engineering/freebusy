load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Gazelle writes the BUILD files from the Go sources; these directives are the
# only hand-written part.
#
# The generated Go in protobuf/generated is committed, so no proto rules: the
# .proto files are buf's input, not Bazel's.
# gazelle:prefix github.com/shokki-engineering/freebusy
# gazelle:proto disable_global
# gazelle:go_naming_convention import
# gazelle:exclude deploy/hasura
# gazelle:exclude deploy/docker
# gazelle:exclude .claude
gazelle(name = "gazelle")

go_library(
    name = "freebusy_lib",
    srcs = [
        "app.go",
        "build.go",
        "main.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/server",
        "//internal/telemetry",
        "@com_github_joho_godotenv//autoload",
        "@com_github_the_protobuf_project_runtime_go_grpc//:grpc",
        "@org_golang_x_crypto_x509roots_fallback//:fallback",
    ],
)

go_binary(
    name = "freebusy",
    embed = [":freebusy_lib"],
    visibility = ["//visibility:public"],
    # Filled only when stamping (bazel build --config=release); see build.go.
    x_defs = {
        "buildVersion": "{STABLE_BUILD_VERSION}",
        "buildCommit": "{STABLE_BUILD_COMMIT}",
    },
)
