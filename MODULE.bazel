"""freebusy: the server binary and its container image, built by Bazel.

Go dependencies come from go.work -- the root module and the generated-code
module in protobuf/ -- so Bazel builds exactly what `go build` does. Gazelle
writes every BUILD.bazel from the Go sources: `bazel run //:gazelle`.
"""

module(name = "freebusy")

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# Modules that ship BUILD files of their own, written for their own workspace
# (loading @rules_go by a name a go_deps repository cannot see): Gazelle
# replaces them with generated ones, as it does for every other module.
[go_deps.gazelle_override(
    build_file_generation = "clean",
    path = path,
) for path in [
    # Its own BUILD files load @rules_go by a name a go_deps repository
    # cannot see.
    "github.com/the-protobuf-project/grpc-mcp-gateway",
    # Its own BUILD files name targets go_default_library, the old convention.
    "cel.dev/cel-go",
]]

use_repo(go_deps, "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go", "build_buf_gen_go_the_protobuf_project_rfc_grpc_go", "build_buf_gen_go_the_protobuf_project_rfc_protocolbuffers_go", "com_github_grpc_ecosystem_grpc_gateway_v2", "com_github_jackc_pgx_v5", "com_github_joho_godotenv", "com_github_knadh_koanf_parsers_toml", "com_github_knadh_koanf_providers_env_v2", "com_github_knadh_koanf_providers_rawbytes", "com_github_knadh_koanf_v2", "com_github_lib_pq", "com_github_modelcontextprotocol_go_sdk", "com_github_the_protobuf_project_cache", "com_github_the_protobuf_project_grpc_mcp_gateway", "com_github_the_protobuf_project_runtime_go_agents", "com_github_the_protobuf_project_runtime_go_cache", "com_github_the_protobuf_project_runtime_go_grpc", "com_github_the_protobuf_project_runtime_go_network", "com_github_the_protobuf_project_runtime_go_observability", "com_github_the_protobuf_project_runtime_go_rfc", "com_github_the_protobuf_project_runtime_go_telemetry", "com_github_the_protobuf_project_runtime_go_ulid", "com_github_the_protobuf_project_store", "com_github_the_protobuf_project_telemetry_telemetry_go", "com_google_cloud_go_longrunning", "in_gopkg_yaml_v3", "io_gorm_driver_postgres", "io_gorm_gorm", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_trace", "org_golang_google_genproto", "org_golang_google_genproto_googleapis_api", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_crypto_x509roots_fallback")

# The migrations image's base: atlas, which applies migrations/ (//image:migrations).
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "atlas",
    digest = "sha256:57f5560604d8a9595eb2bbd91177a2455e33143842c5691e6cde2fa2c6f1a226",
    image = "docker.io/arigaio/atlas",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    tag = "1.3.0-community",
)
use_repo(oci, "atlas", "atlas_linux_amd64", "atlas_linux_arm64")
