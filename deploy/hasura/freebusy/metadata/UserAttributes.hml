  graphql:
    selectTypeName: UserAttributesAggExp

---
kind: OrderByExpression
version: v1
definition:
  name: UserAttributesOrderByExp
  operand:
    object:
      orderedType: UserAttributes
      orderableFields:
        - fieldName: attributeType
