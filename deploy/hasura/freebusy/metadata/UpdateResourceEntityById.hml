      description: Update the 'etag' column in the 'resource_entity' collection.
    - name: expireTime
      type: UpdateColumnResourceEntityExpireTime
      description: Update the 'expire_time' column in the 'resource_entity' collection.
    - name: icalUid
      type: UpdateColumnResourceEntityIcalUid
      description: Update the 'ical_uid' column in the 'resource_entity' collection.
    - name: id
      type: UpdateColumnResourceEntityId
      description: Update the 'id' column in the 'resource_entity' collection.
    - name: name
      type: UpdateColumnResourceEntityName
      description: Update the 'name' column in the 'resource_entity' collection.
    - name: position
      type: UpdateColumnResourceEntityPosition
      description: Update the 'position' column in the 'resource_entity' collection.
    - name: resourceTypes
      type: UpdateColumnResourceEntityResourceTypes
      description: Update the 'resource_types' column in the 'resource_entity' collection.
    - name: uid
      type: UpdateColumnResourceEntityUid
      description: Update the 'uid' column in the 'resource_entity' collection.
    - name: updateTime
      type: UpdateColumnResourceEntityUpdateTime
      description: Update the 'update_time' column in the 'resource_entity' collection.
  graphql:
    typeName: freebusy_UpdateResourceEntityByIdUpdateColumns
    inputTypeName: freebusy_UpdateResourceEntityByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_resource_entity_by_id_update_columns
      fieldMapping:
        calendar:
          column:
            name: calendar
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        name:
          column:
            name: name
        position:
          column:
            name: position
        resourceTypes:
          column:
            name: resource_types
        uid:
          column:
            name: uid
        updateTime:
