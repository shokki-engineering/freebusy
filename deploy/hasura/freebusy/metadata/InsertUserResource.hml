          - returning

---
kind: Command
version: v1
definition:
  name: InsertUserResource
  outputType: InsertUserResourceResponse!
  arguments:
    - name: objects
      type: "[InsertUserResourceObject!]!"
    - name: postCheck
      type: UserResourceBoolExp
      description: Insert permission predicate over the 'user_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_user_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertUserResource
    rootFieldKind: Mutation
  description: Insert into the user_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertUserResource
  permissions:
    - role: admin
      allowExecution: true

