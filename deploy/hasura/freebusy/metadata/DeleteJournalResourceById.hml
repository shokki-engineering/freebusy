---
kind: ObjectType
version: v1
definition:
  name: DeleteJournalResourceByIdResponse
  description: Responses from the 'delete_journal_resource_by_id' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[JournalResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_DeleteJournalResourceByIdResponse
    inputTypeName: freebusy_DeleteJournalResourceByIdResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: delete_journal_resource_by_id_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: DeleteJournalResourceByIdResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: DeleteJournalResourceById
  outputType: DeleteJournalResourceByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: preCheck
      type: JournalResourceBoolExp
      description: Delete permission predicate over the 'journal_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: delete_journal_resource_by_id
    argumentMapping:
      keyId: key_id
      preCheck: pre_check
  graphql:
    rootFieldName: freebusy_deleteJournalResourceById
    rootFieldKind: Mutation
  description: Delete any row on the 'journal_resource' collection using the 'id' key

---
kind: CommandPermissions
version: v1
definition:
  commandName: DeleteJournalResourceById
  permissions:
    - role: admin
