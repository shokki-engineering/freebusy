      description: Update the 'contact_id' column in the 'vcard_languages' collection.
    - name: id
      type: UpdateColumnVcardLanguagesId
      description: Update the 'id' column in the 'vcard_languages' collection.
    - name: pref
      type: UpdateColumnVcardLanguagesPref
      description: Update the 'pref' column in the 'vcard_languages' collection.
    - name: types
      type: UpdateColumnVcardLanguagesTypes
      description: Update the 'types' column in the 'vcard_languages' collection.
    - name: value
      type: UpdateColumnVcardLanguagesValue
      description: Update the 'value' column in the 'vcard_languages' collection.
  graphql:
    typeName: freebusy_UpdateVcardLanguagesByIdUpdateColumns
    inputTypeName: freebusy_UpdateVcardLanguagesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_languages_by_id_update_columns
      fieldMapping:
        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        types:
          column:
            name: types
        value:
          column:
            name: value

