      dataConnectorObjectType: vcard_contacts
      fieldMapping:
        anniversaryId:
          column:
            name: anniversary_id
        birthdayId:
          column:
            name: birthday_id
        categories:
          column:
            name: categories
        defaultLanguageCode:
          column:
            name: default_language_code
        displayNames:
          column:
            name: display_names
        id:
          column:
            name: id
        kind:
          column:
            name: kind
        nameComponentsId:
          column:
            name: name_components_id
        notes:
          column:
            name: notes
        titles:
          column:
            name: titles

---
kind: TypePermissions
version: v1
definition:
  typeName: VcardContacts
  permissions:
