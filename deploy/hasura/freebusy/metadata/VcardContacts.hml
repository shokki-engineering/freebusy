---
kind: ObjectType
version: v1
definition:
  name: VcardContacts
  fields:
    - name: anniversaryId
      type: String_1
    - name: birthdayId
      type: String_1
    - name: categories
      type: "[String_1]"
    - name: defaultLanguageCode
      type: String_1
    - name: displayNames
      type: "[String_1]!"
    - name: id
      type: String_1!
    - name: kind
      type: String_1
    - name: nameComponentsId
      type: String_1
    - name: notes
      type: "[String_1]"
    - name: titles
      type: "[String_1]"
  graphql:
    typeName: freebusy_VcardContacts
    inputTypeName: freebusy_VcardContactsInput
  dataConnectorTypeMapping:
