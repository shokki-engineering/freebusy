  name: VcardContactsBoolExp
  operand:
    object:
      type: VcardContacts
      comparableFields:
        - fieldName: anniversaryId
          booleanExpressionType: TextBoolExp
        - fieldName: birthdayId
          booleanExpressionType: TextBoolExp
        - fieldName: defaultLanguageCode
          booleanExpressionType: TextBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: kind
          booleanExpressionType: TextBoolExp
        - fieldName: nameComponentsId
