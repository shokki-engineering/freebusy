---
kind: ObjectType
version: v1
definition:
  name: ResourceEntity
  fields:
    - name: calendar
      type: String_1
    - name: createTime
      type: Timestamptz!
    - name: deleteTime
      type: Timestamptz
    - name: description
      type: String_1
    - name: displayName
      type: String_1
    - name: etag
      type: String_1
    - name: expireTime
      type: Timestamptz
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: name
      type: String_1!
    - name: position
      type: String_1
    - name: resourceTypes
      type: "[String_1]"
    - name: uid
      type: String_1
    - name: updateTime
      type: Timestamptz!
  graphql:
    typeName: freebusy_ResourceEntity
    inputTypeName: freebusy_ResourceEntityInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: resource_entity
      fieldMapping:
        calendar:
          column:
            name: calendar
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        name:
          column:
            name: name
        position:
          column:
            name: position
        resourceTypes:
          column:
            name: resource_types
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

---
kind: TypePermissions
version: v1
definition:
  typeName: ResourceEntity
  permissions:
    - role: admin
      output:
        allowedFields:
          - calendar
          - createTime
          - deleteTime
          - description
          - displayName
          - etag
          - expireTime
          - icalUid
          - id
          - name
          - position
          - resourceTypes
          - uid
          - updateTime

---
kind: BooleanExpressionType
version: v1
definition:
  name: ResourceEntityBoolExp
  operand:
    object:
      type: ResourceEntity
      comparableFields:
        - fieldName: calendar
          booleanExpressionType: TextBoolExp
        - fieldName: createTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: deleteTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: description
          booleanExpressionType: TextBoolExp
        - fieldName: displayName
          booleanExpressionType: TextBoolExp
        - fieldName: etag
          booleanExpressionType: TextBoolExp
        - fieldName: expireTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: icalUid
          booleanExpressionType: TextBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: name
          booleanExpressionType: TextBoolExp
        - fieldName: position
          booleanExpressionType: TextBoolExp
        - fieldName: uid
          booleanExpressionType: TextBoolExp
        - fieldName: updateTime
          booleanExpressionType: TimestamptzBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: freebusy_ResourceEntityBoolExp

---
kind: AggregateExpression
version: v1
