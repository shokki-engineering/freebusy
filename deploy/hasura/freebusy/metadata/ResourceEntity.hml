---
kind: Model
version: v2
definition:
  name: ResourceEntity
  objectType: ResourceEntity
  source:
    dataConnectorName: freebusy_pgsql
    collection: resource_entity
  filterExpressionType: ResourceEntityBoolExp
  aggregateExpression: ResourceEntityAggExp
  orderByExpression: ResourceEntityOrderByExp
  graphql:
    selectMany:
      queryRootField: freebusy_resourceEntity
      subscription:
        rootField: freebusy_resourceEntity
    selectUniques:
      - queryRootField: freebusy_resourceEntityById
        uniqueIdentifier:
          - id
        subscription:
          rootField: freebusy_resourceEntityById
    filterInputTypeName: freebusy_ResourceEntityFilterInput
    aggregate:
      queryRootField: freebusy_resourceEntityAggregate
      subscription:
        rootField: freebusy_resourceEntityAggregate

