---
kind: ObjectType
version: v1
definition:
  name: InsertStreamResourceObject
  fields:
    - name: baseVersion
      type: Int32
    - name: closed
      type: Boolean_1
    - name: createTime
      type: Timestamptz!
    - name: deleteTime
      type: Timestamptz
    - name: etag
      type: String_1
    - name: expireTime
      type: Timestamptz
    - name: id
      type: String_1!
    - name: name
      type: String_1!
    - name: uid
      type: String_1
    - name: updateTime
      type: Timestamptz!
  graphql:
    typeName: freebusy_InsertStreamResourceObject
    inputTypeName: freebusy_InsertStreamResourceObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_stream_resource_object
      fieldMapping:
        baseVersion:
          column:
            name: base_version
        closed:
          column:
            name: closed
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        id:
          column:
            name: id
        name:
          column:
            name: name
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertStreamResourceObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - baseVersion
          - closed
          - createTime
          - deleteTime
          - etag
          - expireTime
          - id
          - name
          - uid
          - updateTime

---
kind: ObjectType
version: v1
definition:
  name: InsertStreamResourceResponse
  description: Responses from the 'insert_stream_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[StreamResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertStreamResourceResponse
    inputTypeName: freebusy_InsertStreamResourceResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_stream_resource_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertStreamResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertStreamResource
  outputType: InsertStreamResourceResponse!
  arguments:
    - name: objects
      type: "[InsertStreamResourceObject!]!"
    - name: postCheck
      type: StreamResourceBoolExp
      description: Insert permission predicate over the 'stream_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_stream_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertStreamResource
    rootFieldKind: Mutation
  description: Insert into the stream_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertStreamResource
  permissions:
    - role: admin
      allowExecution: true

