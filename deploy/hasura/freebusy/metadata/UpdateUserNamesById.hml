---
kind: Command
version: v1
definition:
  name: UpdateUserNamesById
  outputType: UpdateUserNamesByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: UserNamesBoolExp
      description: Update permission post-condition predicate over the 'user_names'
        collection
    - name: preCheck
      type: UserNamesBoolExp
      description: Update permission pre-condition predicate over the 'user_names'
        collection
    - name: updateColumns
      type: UpdateUserNamesByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_user_names_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateUserNamesById
    rootFieldKind: Mutation
  description: Update any row on the 'user_names' collection using the 'id' key

---
kind: CommandPermissions
version: v1
definition:
  commandName: UpdateUserNamesById
  permissions:
    - role: admin
      allowExecution: true

