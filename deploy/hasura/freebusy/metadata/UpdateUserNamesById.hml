---
kind: ObjectType
version: v1
definition:
  name: UpdateUserNamesByIdUpdateColumns
  description: Update the columns of the 'user_names' collection
  fields:
    - name: displayName
      type: UpdateColumnUserNamesDisplayName
      description: Update the 'display_name' column in the 'user_names' collection.
    - name: familyName
      type: UpdateColumnUserNamesFamilyName
      description: Update the 'family_name' column in the 'user_names' collection.
    - name: givenName
      type: UpdateColumnUserNamesGivenName
      description: Update the 'given_name' column in the 'user_names' collection.
    - name: honorificPrefix
      type: UpdateColumnUserNamesHonorificPrefix
      description: Update the 'honorific_prefix' column in the 'user_names' collection.
    - name: honorificSuffix
      type: UpdateColumnUserNamesHonorificSuffix
      description: Update the 'honorific_suffix' column in the 'user_names' collection.
    - name: id
      type: UpdateColumnUserNamesId
      description: Update the 'id' column in the 'user_names' collection.
    - name: middleNames
      type: UpdateColumnUserNamesMiddleNames
      description: Update the 'middle_names' column in the 'user_names' collection.
  graphql:
    typeName: freebusy_UpdateUserNamesByIdUpdateColumns
    inputTypeName: freebusy_UpdateUserNamesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_user_names_by_id_update_columns
      fieldMapping:
        displayName:
          column:
            name: display_name
        familyName:
          column:
            name: family_name
        givenName:
          column:
            name: given_name
        honorificPrefix:
          column:
            name: honorific_prefix
        honorificSuffix:
          column:
            name: honorific_suffix
        id:
          column:
            name: id
        middleNames:
          column:
            name: middle_names

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateUserNamesByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - displayName
          - familyName
          - givenName
          - honorificPrefix
          - honorificSuffix
          - id
          - middleNames

