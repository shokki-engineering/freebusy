    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: UpdateVcardContactsById
  outputType: UpdateVcardContactsByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardContactsBoolExp
      description: Update permission post-condition predicate over the
        'vcard_contacts' collection
    - name: preCheck
      type: VcardContactsBoolExp
      description: Update permission pre-condition predicate over the 'vcard_contacts'
        collection
    - name: updateColumns
      type: UpdateVcardContactsByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_vcard_contacts_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateVcardContactsById
    rootFieldKind: Mutation
  description: Update any row on the 'vcard_contacts' collection using the 'id' key

---
kind: CommandPermissions
version: v1
definition:
  commandName: UpdateVcardContactsById
  permissions:
    - role: admin
      allowExecution: true

