---
kind: ObjectType
version: v1
definition:
  name: UpdateVcardContactsByIdUpdateColumns
  description: Update the columns of the 'vcard_contacts' collection
  fields:
    - name: anniversaryId
      type: UpdateColumnVcardContactsAnniversaryId
      description: Update the 'anniversary_id' column in the 'vcard_contacts' collection.
    - name: birthdayId
      type: UpdateColumnVcardContactsBirthdayId
      description: Update the 'birthday_id' column in the 'vcard_contacts' collection.
    - name: categories
      type: UpdateColumnVcardContactsCategories
      description: Update the 'categories' column in the 'vcard_contacts' collection.
    - name: defaultLanguageCode
      type: UpdateColumnVcardContactsDefaultLanguageCode
      description: Update the 'default_language_code' column in the 'vcard_contacts'
        collection.
    - name: displayNames
      type: UpdateColumnVcardContactsDisplayNames
      description: Update the 'display_names' column in the 'vcard_contacts' collection.
    - name: id
      type: UpdateColumnVcardContactsId
      description: Update the 'id' column in the 'vcard_contacts' collection.
    - name: kind
      type: UpdateColumnVcardContactsKind
      description: Update the 'kind' column in the 'vcard_contacts' collection.
    - name: nameComponentsId
      type: UpdateColumnVcardContactsNameComponentsId
      description: Update the 'name_components_id' column in the 'vcard_contacts'
        collection.
    - name: notes
      type: UpdateColumnVcardContactsNotes
      description: Update the 'notes' column in the 'vcard_contacts' collection.
    - name: titles
      type: UpdateColumnVcardContactsTitles
      description: Update the 'titles' column in the 'vcard_contacts' collection.
  graphql:
    typeName: freebusy_UpdateVcardContactsByIdUpdateColumns
    inputTypeName: freebusy_UpdateVcardContactsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_contacts_by_id_update_columns
      fieldMapping:
        anniversaryId:
          column:
            name: anniversary_id
        birthdayId:
          column:
            name: birthday_id
        categories:
          column:
            name: categories
        defaultLanguageCode:
          column:
            name: default_language_code
        displayNames:
          column:
            name: display_names
        id:
          column:
            name: id
        kind:
          column:
            name: kind
        nameComponentsId:
          column:
            name: name_components_id
        notes:
          column:
            name: notes
        titles:
          column:
            name: titles

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateVcardContactsByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - anniversaryId
          - birthdayId
          - categories
          - defaultLanguageCode
          - displayNames
          - id
          - kind
          - nameComponentsId
          - notes
          - titles

