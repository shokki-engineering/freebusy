        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        relationTypes:
          column:
            name: relation_types
        text:
          column:
            name: text
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case

