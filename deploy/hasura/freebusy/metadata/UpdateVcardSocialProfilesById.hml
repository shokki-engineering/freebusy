    - name: types
      type: UpdateColumnVcardSocialProfilesTypes
      description: Update the 'types' column in the 'vcard_social_profiles' collection.
    - name: uri
      type: UpdateColumnVcardSocialProfilesUri
      description: Update the 'uri' column in the 'vcard_social_profiles' collection.
    - name: username
