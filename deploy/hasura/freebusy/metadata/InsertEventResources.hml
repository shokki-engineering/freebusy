---
kind: ObjectType
version: v1
definition:
  name: InsertEventResourcesObject
  fields:
    - name: description
      type: String_1
    - name: displayName
      type: String_1
    - name: eventId
      type: String_1!
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: participantId
      type: String_1!
    - name: position
      type: String_1
    - name: resourceTypes
      type: "[String_1]"
  graphql:
    typeName: freebusy_InsertEventResourcesObject
    inputTypeName: freebusy_InsertEventResourcesObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_resources_object
      fieldMapping:
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        participantId:
          column:
            name: participant_id
        position:
          column:
            name: position
        resourceTypes:
          column:
            name: resource_types

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventResourcesObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - description
          - displayName
          - eventId
          - icalUid
          - id
          - participantId
          - position
          - resourceTypes

---
kind: ObjectType
version: v1
definition:
  name: InsertEventResourcesResponse
  description: Responses from the 'insert_event_resources' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventResources!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertEventResourcesResponse
    inputTypeName: freebusy_InsertEventResourcesResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_resources_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventResourcesResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventResources
  outputType: InsertEventResourcesResponse!
  arguments:
    - name: objects
      type: "[InsertEventResourcesObject!]!"
    - name: postCheck
      type: EventResourcesBoolExp
      description: Insert permission predicate over the 'event_resources' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_resources
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertEventResources
    rootFieldKind: Mutation
  description: Insert into the event_resources table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventResources
  permissions:
    - role: admin
      allowExecution: true

