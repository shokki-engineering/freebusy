---
kind: TypePermissions
version: v1
definition:
  typeName: InsertTodoResourceObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - calendarId
          - classification
          - completedId
          - completion
          - createTime
          - deadlineCase
          - deleteTime
          - description
          - dueId
          - duration
          - etag
          - expireTime
          - icalUid
          - id
          - location
          - name
          - percentComplete
          - priority
          - startId
          - summary
          - uid
          - updateTime

---
kind: ObjectType
version: v1
definition:
  name: InsertTodoResourceResponse
  description: Responses from the 'insert_todo_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[TodoResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertTodoResourceResponse
    inputTypeName: InsertTodoResourceResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_todo_resource_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertTodoResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertTodoResource
  outputType: InsertTodoResourceResponse!
  arguments:
    - name: objects
      type: "[InsertTodoResourceObject!]!"
    - name: postCheck
      type: TodoResourceBoolExp
      description: Insert permission predicate over the 'todo_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_todo_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertTodoResource
    rootFieldKind: Mutation
  description: Insert into the todo_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertTodoResource
  permissions:
    - role: admin
      allowExecution: true

