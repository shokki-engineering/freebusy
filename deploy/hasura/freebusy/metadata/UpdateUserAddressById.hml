---
kind: ObjectType
version: v1
definition:
  name: UpdateUserAddressByIdUpdateColumns
  description: Update the columns of the 'user_address' collection
  fields:
    - name: attributeType
      type: UpdateColumnUserAddressAttributeType
      description: Update the 'attribute_type' column in the 'user_address' collection.
    - name: fullAddress
      type: UpdateColumnUserAddressFullAddress
      description: Update the 'full_address' column in the 'user_address' collection.
    - name: id
      type: UpdateColumnUserAddressId
      description: Update the 'id' column in the 'user_address' collection.
    - name: locality
      type: UpdateColumnUserAddressLocality
      description: Update the 'locality' column in the 'user_address' collection.
    - name: postalCode
      type: UpdateColumnUserAddressPostalCode
      description: Update the 'postal_code' column in the 'user_address' collection.
    - name: primary
      type: UpdateColumnUserAddressPrimary
      description: Update the 'primary' column in the 'user_address' collection.
    - name: region
      type: UpdateColumnUserAddressRegion
      description: Update the 'region' column in the 'user_address' collection.
    - name: regionCode
      type: UpdateColumnUserAddressRegionCode
      description: Update the 'region_code' column in the 'user_address' collection.
    - name: streetAddress
      type: UpdateColumnUserAddressStreetAddress
      description: Update the 'street_address' column in the 'user_address' collection.
    - name: userId
      type: UpdateColumnUserAddressUserId
      description: Update the 'user_id' column in the 'user_address' collection.
  graphql:
    typeName: freebusy_UpdateUserAddressByIdUpdateColumns
    inputTypeName: freebusy_UpdateUserAddressByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_user_address_by_id_update_columns
      fieldMapping:
        attributeType:
          column:
            name: attribute_type
        fullAddress:
          column:
            name: full_address
        id:
          column:
            name: id
        locality:
          column:
            name: locality
        postalCode:
          column:
            name: postal_code
        primary:
          column:
            name: primary
        region:
          column:
            name: region
        regionCode:
          column:
            name: region_code
        streetAddress:
          column:
            name: street_address
        userId:
          column:
            name: user_id

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateUserAddressByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - attributeType
          - fullAddress
          - id
          - locality
          - postalCode
          - primary
          - region
          - regionCode
          - streetAddress
          - userId

