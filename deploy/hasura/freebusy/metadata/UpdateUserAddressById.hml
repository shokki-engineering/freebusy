---
kind: Command
version: v1
definition:
  name: UpdateUserAddressById
  outputType: UpdateUserAddressByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: UserAddressBoolExp
      description: Update permission post-condition predicate over the 'user_address'
        collection
    - name: preCheck
      type: UserAddressBoolExp
      description: Update permission pre-condition predicate over the 'user_address'
        collection
    - name: updateColumns
      type: UpdateUserAddressByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_user_address_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateUserAddressById
    rootFieldKind: Mutation
  description: Update any row on the 'user_address' collection using the 'id' key

