---
kind: ObjectType
version: v1
definition:
  name: InsertVcardLanguagesObject
  fields:
    - name: contactId
      type: String_1!
    - name: id
      type: String_1!
    - name: pref
      type: Int32
    - name: types
      type: String_1
    - name: value
      type: String_1!
  graphql:
    typeName: freebusy_InsertVcardLanguagesObject
    inputTypeName: freebusy_InsertVcardLanguagesObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_languages_object
      fieldMapping:
        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        types:
          column:
            name: types
        value:
          column:
            name: value

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardLanguagesObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - contactId
          - id
          - pref
          - types
          - value

---
kind: ObjectType
version: v1
definition:
  name: InsertVcardLanguagesResponse
  description: Responses from the 'insert_vcard_languages' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[VcardLanguages!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertVcardLanguagesResponse
    inputTypeName: freebusy_InsertVcardLanguagesResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_languages_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardLanguagesResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertVcardLanguages
  outputType: InsertVcardLanguagesResponse!
  arguments:
    - name: objects
      type: "[InsertVcardLanguagesObject!]!"
    - name: postCheck
      type: VcardLanguagesBoolExp
      description: Insert permission predicate over the 'vcard_languages' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_vcard_languages
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertVcardLanguages
    rootFieldKind: Mutation
  description: Insert into the vcard_languages table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertVcardLanguages
  permissions:
    - role: admin
      allowExecution: true

