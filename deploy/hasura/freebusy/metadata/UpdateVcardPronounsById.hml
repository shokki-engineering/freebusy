  outputType: UpdateVcardPronounsByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardPronounsBoolExp
      description: Update permission post-condition predicate over the
        'vcard_pronouns' collection
    - name: preCheck
      type: VcardPronounsBoolExp
      description: Update permission pre-condition predicate over the 'vcard_pronouns'
        collection
    - name: updateColumns
      type: UpdateVcardPronounsByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_vcard_pronouns_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateVcardPronounsById
    rootFieldKind: Mutation
  description: Update any row on the 'vcard_pronouns' collection using the 'id' key

