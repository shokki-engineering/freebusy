---
kind: ObjectType
version: v1
definition:
  name: UpdateVcardPronounsByIdUpdateColumns
  description: Update the columns of the 'vcard_pronouns' collection
  fields:
    - name: contactId
      type: UpdateColumnVcardPronounsContactId
      description: Update the 'contact_id' column in the 'vcard_pronouns' collection.
    - name: id
      type: UpdateColumnVcardPronounsId
      description: Update the 'id' column in the 'vcard_pronouns' collection.
    - name: languageCode
      type: UpdateColumnVcardPronounsLanguageCode
      description: Update the 'language_code' column in the 'vcard_pronouns' collection.
    - name: pref
      type: UpdateColumnVcardPronounsPref
      description: Update the 'pref' column in the 'vcard_pronouns' collection.
    - name: types
      type: UpdateColumnVcardPronounsTypes
      description: Update the 'types' column in the 'vcard_pronouns' collection.
    - name: value
      type: UpdateColumnVcardPronounsValue
      description: Update the 'value' column in the 'vcard_pronouns' collection.
  graphql:
    typeName: freebusy_UpdateVcardPronounsByIdUpdateColumns
    inputTypeName: freebusy_UpdateVcardPronounsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_pronouns_by_id_update_columns
      fieldMapping:
        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        languageCode:
          column:
            name: language_code
        pref:
          column:
            name: pref
        types:
          column:
            name: types
        value:
          column:
            name: value

---
kind: TypePermissions
