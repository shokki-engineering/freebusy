---
kind: ObjectType
version: v1
definition:
  name: InsertStreamRecordsObject
  fields:
    - name: baseSensorId
      type: String_1
    - name: baseSum
      type: Float64
    - name: baseTimeValue
      type: Float64
    - name: baseUnit
      type: String_1
    - name: baseValue
      type: Float64
    - name: booleanValue
      type: Boolean_1
    - name: dataValue
      type: Json
    - name: id
      type: String_1!
    - name: numberValue
      type: Float64
    - name: sensorId
      type: String_1
    - name: stringValue
      type: String_1
    - name: sum
      type: Float64
    - name: timeValue
      type: Float64
    - name: unit
      type: String_1
    - name: updateDuration
      type: String_1
    - name: valueCase
      type: String_1
  graphql:
    typeName: freebusy_InsertStreamRecordsObject
    inputTypeName: freebusy_InsertStreamRecordsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_stream_records_object
      fieldMapping:
        baseSensorId:
          column:
            name: base_sensor_id
        baseSum:
          column:
            name: base_sum
        baseTimeValue:
          column:
            name: base_time_value
        baseUnit:
          column:
            name: base_unit
        baseValue:
          column:
            name: base_value
        booleanValue:
          column:
            name: boolean_value
        dataValue:
          column:
            name: data_value
        id:
          column:
            name: id
        numberValue:
          column:
            name: number_value
        sensorId:
          column:
            name: sensor_id
        stringValue:
          column:
            name: string_value
        sum:
          column:
            name: sum
        timeValue:
          column:
            name: time_value
        unit:
          column:
            name: unit
        updateDuration:
          column:
            name: update_duration
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertStreamRecordsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - baseSensorId
          - baseSum
          - baseTimeValue
          - baseUnit
          - baseValue
          - booleanValue
          - dataValue
          - id
          - numberValue
          - sensorId
          - stringValue
          - sum
          - timeValue
          - unit
          - updateDuration
          - valueCase

---
kind: ObjectType
version: v1
definition:
  name: InsertStreamRecordsResponse
  description: Responses from the 'insert_stream_records' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[StreamRecords!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertStreamRecordsResponse
    inputTypeName: freebusy_InsertStreamRecordsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_stream_records_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertStreamRecordsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertStreamRecords
  outputType: InsertStreamRecordsResponse!
  arguments:
    - name: objects
      type: "[InsertStreamRecordsObject!]!"
    - name: postCheck
      type: StreamRecordsBoolExp
      description: Insert permission predicate over the 'stream_records' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_stream_records
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertStreamRecords
    rootFieldKind: Mutation
  description: Insert into the stream_records table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertStreamRecords
  permissions:
    - role: admin
      allowExecution: true

