  graphql:
    typeName: freebusy_InsertVcardAddressObject
    inputTypeName: freebusy_InsertVcardAddressObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_address_object
      fieldMapping:
        apartments:
          column:
            name: apartments
        blocks:
          column:
            name: blocks
        buildings:
          column:
            name: buildings
        contactId:
          column:
            name: contact_id
        countries:
          column:
            name: countries
        directions:
          column:
            name: directions
        districts:
          column:
            name: districts
        extendedAddresses:
          column:
            name: extended_addresses
        floors:
          column:
            name: floors
        id:
          column:
            name: id
        label:
          column:
            name: label
        landmarks:
          column:
            name: landmarks
        localities:
          column:
            name: localities
        phonetic:
          column:
            name: phonetic
        postOfficeBox:
          column:
            name: post_office_box
        postalCodes:
          column:
            name: postal_codes
        pref:
          column:
            name: pref
        regions:
          column:
            name: regions
        rooms:
          column:
            name: rooms
        script:
          column:
            name: script
        streetAddresses:
          column:
            name: street_addresses
        streetNumbers:
          column:
            name: street_numbers
        streets:
          column:
            name: streets
        subdistricts:
          column:
            name: subdistricts
        types:
          column:
            name: types

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardAddressObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - apartments
          - blocks
          - buildings
          - contactId
          - countries
          - directions
          - districts
          - extendedAddresses
          - floors
          - id
          - label
          - landmarks
          - localities
          - phonetic
          - postOfficeBox
          - postalCodes
          - pref
          - regions
          - rooms
          - script
          - streetAddresses
          - streetNumbers
          - streets
          - subdistricts
          - types

---
kind: ObjectType
version: v1
definition:
  name: InsertVcardAddressResponse
  description: Responses from the 'insert_vcard_address' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[VcardAddress!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertVcardAddressResponse
    inputTypeName: freebusy_InsertVcardAddressResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_address_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardAddressResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertVcardAddress
  outputType: InsertVcardAddressResponse!
  arguments:
    - name: objects
      type: "[InsertVcardAddressObject!]!"
    - name: postCheck
      type: VcardAddressBoolExp
      description: Insert permission predicate over the 'vcard_address' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_vcard_address
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertVcardAddress
    rootFieldKind: Mutation
  description: Insert into the vcard_address table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertVcardAddress
  permissions:
    - role: admin
      allowExecution: true

