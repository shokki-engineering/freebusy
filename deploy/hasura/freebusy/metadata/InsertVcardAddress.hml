      type: "[String_1]"
    - name: blocks
      type: "[String_1]"
    - name: buildings
      type: "[String_1]"
    - name: contactId
      type: String_1!
    - name: countries
      type: "[String_1]"
    - name: directions
      type: "[String_1]"
    - name: districts
      type: "[String_1]"
    - name: extendedAddresses
      type: "[String_1]"
    - name: floors
      type: "[String_1]"
    - name: id
      type: String_1!
    - name: label
      type: String_1
    - name: landmarks
      type: "[String_1]"
    - name: localities
      type: "[String_1]"
    - name: phonetic
