    - name: regions
      type: "[String_1]"
    - name: rooms
      type: "[String_1]"
    - name: script
      type: String_1
    - name: streetAddresses
      type: "[String_1]"
    - name: streetNumbers
      type: "[String_1]"
    - name: streets
      type: "[String_1]"
    - name: subdistricts
