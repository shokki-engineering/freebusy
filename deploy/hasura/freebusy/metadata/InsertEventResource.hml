      description: Insert permission predicate over the 'event_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertEventResource
    rootFieldKind: Mutation
  description: Insert into the event_resource table

---
kind: CommandPermissions
version: v1
definition:
