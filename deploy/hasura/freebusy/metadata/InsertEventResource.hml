---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventResource
  outputType: InsertEventResourceResponse!
  arguments:
    - name: objects
      type: "[InsertEventResourceObject!]!"
    - name: postCheck
