---
kind: ObjectType
version: v1
definition:
  name: InsertEventResourceResponse
  description: Responses from the 'insert_event_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertEventResourceResponse
    inputTypeName: freebusy_InsertEventResourceResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
