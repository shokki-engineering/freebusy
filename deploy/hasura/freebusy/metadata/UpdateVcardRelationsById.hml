---
kind: Command
version: v1
definition:
  name: UpdateVcardRelationsById
  outputType: UpdateVcardRelationsByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardRelationsBoolExp
      description: Update permission post-condition predicate over the
        'vcard_relations' collection
    - name: preCheck
      type: VcardRelationsBoolExp
      description: Update permission pre-condition predicate over the
        'vcard_relations' collection
    - name: updateColumns
      type: UpdateVcardRelationsByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_vcard_relations_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateVcardRelationsById
    rootFieldKind: Mutation
  description: Update any row on the 'vcard_relations' collection using the 'id' key

