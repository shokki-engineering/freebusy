kind: ObjectType
version: v1
definition:
  name: UpdateVcardRelationsByIdUpdateColumns
  description: Update the columns of the 'vcard_relations' collection
  fields:
    - name: contactId
      type: UpdateColumnVcardRelationsContactId
      description: Update the 'contact_id' column in the 'vcard_relations' collection.
    - name: id
      type: UpdateColumnVcardRelationsId
      description: Update the 'id' column in the 'vcard_relations' collection.
    - name: pref
      type: UpdateColumnVcardRelationsPref
      description: Update the 'pref' column in the 'vcard_relations' collection.
    - name: relationTypes
      type: UpdateColumnVcardRelationsRelationTypes
      description: Update the 'relation_types' column in the 'vcard_relations' collection.
    - name: text
      type: UpdateColumnVcardRelationsText
      description: Update the 'text' column in the 'vcard_relations' collection.
    - name: uri
      type: UpdateColumnVcardRelationsUri
      description: Update the 'uri' column in the 'vcard_relations' collection.
    - name: valueCase
      type: UpdateColumnVcardRelationsValueCase
      description: Update the 'value_case' column in the 'vcard_relations' collection.
  graphql:
    typeName: freebusy_UpdateVcardRelationsByIdUpdateColumns
    inputTypeName: freebusy_UpdateVcardRelationsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_relations_by_id_update_columns
      fieldMapping:
        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        relationTypes:
          column:
            name: relation_types
        text:
          column:
            name: text
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateVcardRelationsByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - contactId
          - id
          - pref
          - relationTypes
          - text
          - uri
          - valueCase

