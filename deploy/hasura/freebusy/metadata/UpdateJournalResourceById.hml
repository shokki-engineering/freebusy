      description: Update the 'delete_time' column in the 'journal_resource' collection.
    - name: descriptions
      type: UpdateColumnJournalResourceDescriptions
      description: Update the 'descriptions' column in the 'journal_resource' collection.
    - name: etag
      type: UpdateColumnJournalResourceEtag
      description: Update the 'etag' column in the 'journal_resource' collection.
    - name: expireTime
      type: UpdateColumnJournalResourceExpireTime
      description: Update the 'expire_time' column in the 'journal_resource' collection.
    - name: icalUid
      type: UpdateColumnJournalResourceIcalUid
      description: Update the 'ical_uid' column in the 'journal_resource' collection.
    - name: id
      type: UpdateColumnJournalResourceId
      description: Update the 'id' column in the 'journal_resource' collection.
    - name: name
      type: UpdateColumnJournalResourceName
      description: Update the 'name' column in the 'journal_resource' collection.
    - name: publication
      type: UpdateColumnJournalResourcePublication
      description: Update the 'publication' column in the 'journal_resource' collection.
    - name: startId
      type: UpdateColumnJournalResourceStartId
      description: Update the 'start_id' column in the 'journal_resource' collection.
    - name: summary
      type: UpdateColumnJournalResourceSummary
      description: Update the 'summary' column in the 'journal_resource' collection.
    - name: uid
      type: UpdateColumnJournalResourceUid
      description: Update the 'uid' column in the 'journal_resource' collection.
    - name: updateTime
      type: UpdateColumnJournalResourceUpdateTime
      description: Update the 'update_time' column in the 'journal_resource' collection.
  graphql:
    typeName: freebusy_UpdateJournalResourceByIdUpdateColumns
    inputTypeName: freebusy_UpdateJournalResourceByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_journal_resource_by_id_update_columns
      fieldMapping:
        calendarId:
          column:
            name: calendar_id
        classification:
          column:
            name: classification
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        descriptions:
          column:
            name: descriptions
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        name:
          column:
            name: name
        publication:
          column:
            name: publication
        startId:
          column:
            name: start_id
        summary:
          column:
            name: summary
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

