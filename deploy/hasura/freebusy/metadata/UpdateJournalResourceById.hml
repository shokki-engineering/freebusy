  outputType: UpdateJournalResourceByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: JournalResourceBoolExp
      description: Update permission post-condition predicate over the
        'journal_resource' collection
    - name: preCheck
      type: JournalResourceBoolExp
