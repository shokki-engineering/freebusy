---
kind: ObjectType
version: v1
definition:
  name: PackResource
  fields:
    - name: baseVersion
      type: Int32
    - name: createTime
      type: Timestamptz!
    - name: deleteTime
      type: Timestamptz
    - name: etag
      type: String_1
    - name: expireTime
      type: Timestamptz
    - name: id
      type: String_1!
    - name: name
      type: String_1!
    - name: resolved
      type: Boolean_1
    - name: uid
      type: String_1
    - name: updateTime
      type: Timestamptz!
  graphql:
    typeName: PackResource
    inputTypeName: PackResourceInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: pack_resource
      fieldMapping:
        baseVersion:
          column:
            name: base_version
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        id:
          column:
            name: id
        name:
          column:
            name: name
        resolved:
          column:
            name: resolved
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

---
kind: TypePermissions
version: v1
definition:
  typeName: PackResource
  permissions:
    - role: admin
      output:
        allowedFields:
          - baseVersion
          - createTime
          - deleteTime
          - etag
          - expireTime
          - id
          - name
          - resolved
          - uid
          - updateTime

---
kind: BooleanExpressionType
version: v1
definition:
  name: PackResourceBoolExp
  operand:
    object:
      type: PackResource
      comparableFields:
        - fieldName: baseVersion
          booleanExpressionType: Int4BoolExp
        - fieldName: createTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: deleteTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: etag
          booleanExpressionType: TextBoolExp
        - fieldName: expireTime
          booleanExpressionType: TimestamptzBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: name
          booleanExpressionType: TextBoolExp
        - fieldName: resolved
          booleanExpressionType: BoolBoolExp
        - fieldName: uid
          booleanExpressionType: TextBoolExp
        - fieldName: updateTime
          booleanExpressionType: TimestamptzBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: PackResourceBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: PackResourceAggExp
  operand:
    object:
      aggregatedType: PackResource
      aggregatableFields:
        - fieldName: baseVersion
          aggregateExpression: Int4AggExp
        - fieldName: createTime
          aggregateExpression: TimestamptzAggExp
        - fieldName: deleteTime
          aggregateExpression: TimestamptzAggExp
        - fieldName: etag
          aggregateExpression: TextAggExp
        - fieldName: expireTime
          aggregateExpression: TimestamptzAggExp
        - fieldName: id
          aggregateExpression: TextAggExp
        - fieldName: name
          aggregateExpression: TextAggExp
        - fieldName: resolved
          aggregateExpression: BoolAggExp
        - fieldName: uid
          aggregateExpression: TextAggExp
        - fieldName: updateTime
          aggregateExpression: TimestamptzAggExp
  count:
    enable: true
    returnType: Int64
  graphql:
    selectTypeName: PackResourceAggExp

---
kind: OrderByExpression
version: v1
definition:
  name: PackResourceOrderByExp
  operand:
    object:
      orderedType: PackResource
      orderableFields:
        - fieldName: baseVersion
          orderByExpression: Int32OrderByExp
        - fieldName: createTime
          orderByExpression: TimestamptzOrderByExp
        - fieldName: deleteTime
          orderByExpression: TimestamptzOrderByExp
        - fieldName: etag
          orderByExpression: String1OrderByExp
        - fieldName: expireTime
          orderByExpression: TimestamptzOrderByExp
        - fieldName: id
          orderByExpression: String1OrderByExp
        - fieldName: name
          orderByExpression: String1OrderByExp
        - fieldName: resolved
          orderByExpression: Boolean1OrderByExp
        - fieldName: uid
          orderByExpression: String1OrderByExp
        - fieldName: updateTime
          orderByExpression: TimestamptzOrderByExp
      orderableRelationships: []
  graphql:
    expressionTypeName: PackResourceOrderByExp

---
kind: Model
version: v2
definition:
  name: PackResource
  objectType: PackResource
  source:
    dataConnectorName: freebusy_pgsql
    collection: pack_resource
  filterExpressionType: PackResourceBoolExp
  aggregateExpression: PackResourceAggExp
  orderByExpression: PackResourceOrderByExp
  graphql:
    selectMany:
      queryRootField: packResource
      subscription:
        rootField: packResource
    selectUniques:
      - queryRootField: packResourceById
        uniqueIdentifier:
          - id
        subscription:
          rootField: packResourceById
    filterInputTypeName: PackResourceFilterInput
    aggregate:
      queryRootField: packResourceAggregate
      subscription:
        rootField: packResourceAggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: PackResource
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

