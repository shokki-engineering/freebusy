kind: ObjectType
version: v1
definition:
  name: UpdateEventParticipantsByIdUpdateColumns
  description: Update the columns of the 'event_participants' collection
  fields:
    - name: calendarAddress
      type: UpdateColumnEventParticipantsCalendarAddress
      description: Update the 'calendar_address' column in the 'event_participants'
        collection.
    - name: description
      type: UpdateColumnEventParticipantsDescription
      description: Update the 'description' column in the 'event_participants' collection.
    - name: eventId
      type: UpdateColumnEventParticipantsEventId
      description: Update the 'event_id' column in the 'event_participants' collection.
    - name: icalUid
      type: UpdateColumnEventParticipantsIcalUid
      description: Update the 'ical_uid' column in the 'event_participants' collection.
    - name: id
      type: UpdateColumnEventParticipantsId
      description: Update the 'id' column in the 'event_participants' collection.
    - name: participantTypes
      type: UpdateColumnEventParticipantsParticipantTypes
      description: Update the 'participant_types' column in the 'event_participants'
        collection.
    - name: position
      type: UpdateColumnEventParticipantsPosition
      description: Update the 'position' column in the 'event_participants' collection.
    - name: summary
      type: UpdateColumnEventParticipantsSummary
      description: Update the 'summary' column in the 'event_participants' collection.
    - name: url
      type: UpdateColumnEventParticipantsUrl
      description: Update the 'url' column in the 'event_participants' collection.
  graphql:
    typeName: freebusy_UpdateEventParticipantsByIdUpdateColumns
    inputTypeName: freebusy_UpdateEventParticipantsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_event_participants_by_id_update_columns
      fieldMapping:
        calendarAddress:
          column:
            name: calendar_address
        description:
          column:
            name: description
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        participantTypes:
          column:
            name: participant_types
        position:
          column:
            name: position
        summary:
          column:
            name: summary
        url:
          column:
            name: url

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateEventParticipantsByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - calendarAddress
          - description
          - eventId
          - icalUid
          - id
          - participantTypes
          - position
          - summary
          - url

