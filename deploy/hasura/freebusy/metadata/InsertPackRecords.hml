---
kind: ObjectType
version: v1
definition:
  name: InsertPackRecordsObject
  fields:
    - name: baseSensorId
      type: String_1
    - name: baseSum
      type: Float64
    - name: baseTimeValue
      type: Float64
    - name: baseUnit
      type: String_1
    - name: baseValue
      type: Float64
    - name: booleanValue
      type: Boolean_1
    - name: dataValue
      type: Json
    - name: id
      type: String_1!
    - name: numberValue
      type: Float64
    - name: packId
      type: String_1!
    - name: sensorId
      type: String_1
    - name: stringValue
      type: String_1
    - name: sum
      type: Float64
    - name: timeValue
      type: Float64
    - name: unit
      type: String_1
    - name: updateDuration
      type: String_1
    - name: valueCase
      type: String_1
  graphql:
    typeName: freebusy_InsertPackRecordsObject
    inputTypeName: freebusy_InsertPackRecordsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_pack_records_object
      fieldMapping:
        baseSensorId:
          column:
            name: base_sensor_id
        baseSum:
          column:
            name: base_sum
        baseTimeValue:
          column:
            name: base_time_value
        baseUnit:
          column:
            name: base_unit
        baseValue:
          column:
            name: base_value
        booleanValue:
          column:
            name: boolean_value
        dataValue:
          column:
            name: data_value
        id:
          column:
            name: id
        numberValue:
          column:
            name: number_value
        packId:
          column:
            name: pack_id
        sensorId:
          column:
            name: sensor_id
        stringValue:
          column:
            name: string_value
        sum:
          column:
            name: sum
        timeValue:
          column:
            name: time_value
        unit:
          column:
            name: unit
        updateDuration:
          column:
            name: update_duration
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertPackRecordsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - baseSensorId
          - baseSum
          - baseTimeValue
          - baseUnit
          - baseValue
          - booleanValue
          - dataValue
          - id
          - numberValue
          - packId
          - sensorId
          - stringValue
          - sum
          - timeValue
          - unit
          - updateDuration
          - valueCase

---
kind: ObjectType
version: v1
definition:
  name: InsertPackRecordsResponse
  description: Responses from the 'insert_pack_records' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[PackRecords!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertPackRecordsResponse
    inputTypeName: freebusy_InsertPackRecordsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_pack_records_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertPackRecordsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertPackRecords
  outputType: InsertPackRecordsResponse!
  arguments:
    - name: objects
      type: "[InsertPackRecordsObject!]!"
    - name: postCheck
      type: PackRecordsBoolExp
      description: Insert permission predicate over the 'pack_records' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_pack_records
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertPackRecords
    rootFieldKind: Mutation
  description: Insert into the pack_records table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertPackRecords
  permissions:
    - role: admin
      allowExecution: true

