    - name: display
      type: String_1
    - name: id
      type: String_1!
    - name: primary
      type: Boolean_1
    - name: referenceUri
      type: String_1
    - name: userId
      type: String_1!
    - name: value
      type: String_1
  graphql:
    typeName: freebusy_InsertUserAttributesObject
    inputTypeName: freebusy_InsertUserAttributesObjectInput
