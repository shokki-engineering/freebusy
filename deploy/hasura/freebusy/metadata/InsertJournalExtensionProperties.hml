definition:
  name: InsertJournalExtensionProperties
  outputType: InsertJournalExtensionPropertiesResponse!
  arguments:
    - name: objects
      type: "[InsertJournalExtensionPropertiesObject!]!"
    - name: postCheck
      type: JournalExtensionPropertiesBoolExp
      description: Insert permission predicate over the 'journal_extension_properties'
        collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_journal_extension_properties
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertJournalExtensionProperties
    rootFieldKind: Mutation
  description: Insert into the journal_extension_properties table

---
kind: CommandPermissions
