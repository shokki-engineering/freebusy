      dataConnectorObjectType: insert_journal_extension_properties_object
      fieldMapping:
        id:
          column:
            name: id
        journalId:
          column:
            name: journal_id
        key:
          column:
            name: key
        parameters:
          column:
            name: parameters
        values:
          column:
            name: values

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertJournalExtensionPropertiesObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - id
          - journalId
          - key
          - parameters
          - values

---
kind: ObjectType
version: v1
definition:
  name: InsertJournalExtensionPropertiesResponse
