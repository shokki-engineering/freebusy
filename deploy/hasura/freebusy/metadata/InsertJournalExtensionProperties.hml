---
kind: ObjectType
version: v1
definition:
  name: InsertJournalExtensionPropertiesObject
  fields:
    - name: id
      type: String_1!
    - name: journalId
      type: String_1!
    - name: key
      type: String_1!
    - name: parameters
      type: Json
    - name: values
      type: "[String_1]"
  graphql:
    typeName: freebusy_InsertJournalExtensionPropertiesObject
    inputTypeName: freebusy_InsertJournalExtensionPropertiesObjectInput
  dataConnectorTypeMapping:
