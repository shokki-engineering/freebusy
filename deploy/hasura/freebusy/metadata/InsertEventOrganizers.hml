---
kind: ObjectType
version: v1
definition:
  name: InsertEventOrganizersObject
  fields:
    - name: address
      type: String_1!
    - name: displayName
      type: String_1
    - name: id
      type: String_1!
    - name: sender
      type: String_1
  graphql:
    typeName: freebusy_InsertEventOrganizersObject
    inputTypeName: freebusy_InsertEventOrganizersObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_organizers_object
      fieldMapping:
        address:
          column:
            name: address
        displayName:
          column:
            name: display_name
        id:
          column:
            name: id
        sender:
          column:
            name: sender

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventOrganizersObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - address
          - displayName
          - id
          - sender

---
kind: ObjectType
version: v1
definition:
  name: InsertEventOrganizersResponse
  description: Responses from the 'insert_event_organizers' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventOrganizers!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertEventOrganizersResponse
    inputTypeName: freebusy_InsertEventOrganizersResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_organizers_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventOrganizersResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventOrganizers
  outputType: InsertEventOrganizersResponse!
  arguments:
    - name: objects
      type: "[InsertEventOrganizersObject!]!"
    - name: postCheck
      type: EventOrganizersBoolExp
      description: Insert permission predicate over the 'event_organizers' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_organizers
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertEventOrganizers
    rootFieldKind: Mutation
  description: Insert into the event_organizers table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventOrganizers
  permissions:
    - role: admin
      allowExecution: true

