---
kind: ObjectType
version: v1
definition:
  name: InsertCardResourceResponse
  description: Responses from the 'insert_card_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[CardResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertCardResourceResponse
    inputTypeName: freebusy_InsertCardResourceResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_card_resource_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertCardResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertCardResource
  outputType: InsertCardResourceResponse!
  arguments:
    - name: objects
      type: "[InsertCardResourceObject!]!"
    - name: postCheck
      type: CardResourceBoolExp
      description: Insert permission predicate over the 'card_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_card_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertCardResource
    rootFieldKind: Mutation
  description: Insert into the card_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertCardResource
  permissions:
    - role: admin
      allowExecution: true

