---
kind: ObjectType
version: v1
definition:
  name: InsertEventLinksObject
  fields:
    - name: eventId
      type: String_1!
    - name: formatType
      type: String_1
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: label
      type: String_1
    - name: languageCode
      type: String_1
    - name: relation
      type: String_1!
    - name: uri
      type: String_1
    - name: valueCase
      type: String_1
    - name: xmlReference
      type: String_1
  graphql:
    typeName: freebusy_InsertEventLinksObject
    inputTypeName: freebusy_InsertEventLinksObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_links_object
      fieldMapping:
        eventId:
          column:
            name: event_id
        formatType:
          column:
            name: format_type
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        label:
          column:
            name: label
        languageCode:
          column:
            name: language_code
        relation:
          column:
            name: relation
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case
        xmlReference:
          column:
            name: xml_reference

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventLinksObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - eventId
          - formatType
          - icalUid
          - id
          - label
          - languageCode
          - relation
          - uri
          - valueCase
          - xmlReference

---
kind: ObjectType
version: v1
definition:
  name: InsertEventLinksResponse
  description: Responses from the 'insert_event_links' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventLinks!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: freebusy_InsertEventLinksResponse
    inputTypeName: freebusy_InsertEventLinksResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_links_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventLinksResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventLinks
  outputType: InsertEventLinksResponse!
  arguments:
    - name: objects
      type: "[InsertEventLinksObject!]!"
    - name: postCheck
      type: EventLinksBoolExp
      description: Insert permission predicate over the 'event_links' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_links
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: freebusy_insertEventLinks
    rootFieldKind: Mutation
  description: Insert into the event_links table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventLinks
  permissions:
    - role: admin
      allowExecution: true

