---
kind: ObjectType
version: v1
definition:
  name: UpdateVcardTelephonesByIdUpdateColumns
  description: Update the columns of the 'vcard_telephones' collection
  fields:
    - name: contactId
      type: UpdateColumnVcardTelephonesContactId
      description: Update the 'contact_id' column in the 'vcard_telephones' collection.
    - name: features
      type: UpdateColumnVcardTelephonesFeatures
      description: Update the 'features' column in the 'vcard_telephones' collection.
    - name: id
      type: UpdateColumnVcardTelephonesId
      description: Update the 'id' column in the 'vcard_telephones' collection.
    - name: pref
      type: UpdateColumnVcardTelephonesPref
      description: Update the 'pref' column in the 'vcard_telephones' collection.
    - name: text
      type: UpdateColumnVcardTelephonesText
      description: Update the 'text' column in the 'vcard_telephones' collection.
    - name: types
      type: UpdateColumnVcardTelephonesTypes
      description: Update the 'types' column in the 'vcard_telephones' collection.
    - name: uri
      type: UpdateColumnVcardTelephonesUri
      description: Update the 'uri' column in the 'vcard_telephones' collection.
    - name: valueCase
      type: UpdateColumnVcardTelephonesValueCase
      description: Update the 'value_case' column in the 'vcard_telephones' collection.
  graphql:
    typeName: freebusy_UpdateVcardTelephonesByIdUpdateColumns
    inputTypeName: freebusy_UpdateVcardTelephonesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_telephones_by_id_update_columns
      fieldMapping:
        contactId:
          column:
            name: contact_id
        features:
          column:
            name: features
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        text:
          column:
            name: text
        types:
          column:
            name: types
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateVcardTelephonesByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - contactId
          - features
          - id
          - pref
          - text
          - types
          - uri
          - valueCase

