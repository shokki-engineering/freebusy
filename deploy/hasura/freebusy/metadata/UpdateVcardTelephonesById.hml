---
kind: Command
version: v1
definition:
  name: UpdateVcardTelephonesById
  outputType: UpdateVcardTelephonesByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardTelephonesBoolExp
      description: Update permission post-condition predicate over the
        'vcard_telephones' collection
    - name: preCheck
      type: VcardTelephonesBoolExp
      description: Update permission pre-condition predicate over the
        'vcard_telephones' collection
    - name: updateColumns
      type: UpdateVcardTelephonesByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_vcard_telephones_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: freebusy_updateVcardTelephonesById
    rootFieldKind: Mutation
  description: Update any row on the 'vcard_telephones' collection using the 'id' key

---
kind: CommandPermissions
version: v1
definition:
  commandName: UpdateVcardTelephonesById
  permissions:
    - role: admin
      allowExecution: true

