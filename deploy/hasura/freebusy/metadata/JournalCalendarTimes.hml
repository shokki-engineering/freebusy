      dataConnectorObjectType: journal_calendar_times
      fieldMapping:
        date:
          column:
            name: date
        dateTime:
          column:
            name: date_time
        dateTimeZone:
          column:
            name: date_time_zone
        id:
          column:
            name: id
        valueCase:
          column:
            name: value_case

