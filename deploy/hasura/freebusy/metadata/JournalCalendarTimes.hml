      type: Date
    - name: dateTime
      type: Timestamptz
    - name: dateTimeZone
      type: String_1
    - name: id
      type: String_1!
    - name: valueCase
      type: String_1
  graphql:
    typeName: freebusy_JournalCalendarTimes
    inputTypeName: freebusy_JournalCalendarTimesInput
  dataConnectorTypeMapping:
