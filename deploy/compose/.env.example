# The Compose stack's settings: copy to .env, which is never committed, and
# replace every CHANGE_ME. Any other freebusy setting can be added to the
# freebusy service as FREEBUSY_<SECTION>__<KEY> (see the README).

# The release to run: a tag of ghcr.io/shokki-engineering/freebusy and
# freebusy-migrations (and, with the hasura profile, freebusy-engine and
# freebusy-connector).
FREEBUSY_TAG=latest

# openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
# Seals webhook signing secrets at rest: openssl rand -base64 32. Keep it:
# losing it makes every webhook's secret unreadable.
WEBHOOK_SECRET_KEY=CHANGE_ME
# After rotating WEBHOOK_SECRET_KEY, the old key(s), comma-separated.
WEBHOOK_PREVIOUS_SECRET_KEYS=

# gorm (Postgres, the default) or hasura (with the hasura profile).
FREEBUSY_DATABASE_PROVIDER=gorm

# The reservation list cache, with the cache profile.
FREEBUSY_CACHE_ENABLED=false
REDIS_PASSWORD=CHANGE_ME

# telemetry:6009 with the observability profile, or your own collector
# (host:port, OTLP gRPC). Empty exports nothing.
OTLP_ENDPOINT=
# The engine and connector want a URL: http://telemetry:6009.
ENGINE_OTLP_ENDPOINT=
TELEMETRY_ENVIRONMENT=production
# Labels this deployment's telemetry, e.g. riverside-club.
FREEBUSY_SITE=

# Search: "opensearch" searches the search profile's OpenSearch (or
# OPENSEARCH_URL's cluster), falling back to Postgres; "postgres" (default)
# searches the read model's table.
FREEBUSY_SEARCH_PROVIDER=postgres
FREEBUSY_SEARCH_HORIZON_DAYS=365
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Backups: where, how often, how long they are kept.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
