load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "errors_lib",
    srcs = [
        "fragments.go",
        "main.go",
        "reasons.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy/tools/errors",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "errors",
    embed = [":errors_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "errors_test",
    srcs = ["errors_test.go"],
    embed = [":errors_lib"],
)
