load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "license_lib",
    srcs = [
        "header.go",
        "main.go",
        "rules.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy/tools/license",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "license",
    embed = [":license_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "license_test",
    srcs = ["license_test.go"],
    embed = [":license_lib"],
)
