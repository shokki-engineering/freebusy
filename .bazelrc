# Bzlmod only; Bazel 9 has no WORKSPACE.
common --enable_bzlmod

# Pure Go: no cgo anywhere, so every binary is static and cross-compiles with
# nothing but the Go toolchain.
build --@rules_go//go/config:pure

# Tests that need Postgres or Hasura read FREEBUSY_TEST_*; pass them through.
test --test_env=FREEBUSY_TEST_POSTGRES_DSN --test_env=FREEBUSY_TEST_DATABASE_URL
test --test_env=FREEBUSY_TEST_GRAPHQL_URL --test_env=FREEBUSY_TEST_REQUIRE_LIVE
test --test_output=errors

# Release builds stamp the server binary with the tag and commit
# (tools/bazel/status.sh, the x_defs on //:freebusy): `freebusy --version` and
# the startup line report them. Unstamped builds say "dev".
build:release --stamp --workspace_status_command=tools/bazel/status.sh

# A developer's own flags, never committed.
try-import %workspace%/.bazelrc.user
