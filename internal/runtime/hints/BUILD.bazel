load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hints",
    srcs = ["hints.go"],
    importpath = "github.com/shokki-engineering/freebusy/internal/runtime/hints",
    visibility = ["//:__subpackages__"],
    deps = [
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
    ],
)

go_test(
    name = "hints_test",
    srcs = ["hints_test.go"],
    embed = [":hints"],
    deps = [
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@build_buf_gen_go_the_protobuf_project_rfc_protocolbuffers_go//protobuf/rfc4519/organization/v1:organization",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
