load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reservation",
    srcs = [
        "hold.go",
        "reschedule.go",
        "reservation.go",
        "store.go",
        "update.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy/internal/service/reservation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/database/repository/repox",
        "//internal/service/generated/servicex",
        "//internal/service/rpc",
        "//protobuf/generated/go/allocation/v1/allocationpbv1",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@com_github_the_protobuf_project_runtime_go_grpc//hints",
        "@com_github_the_protobuf_project_runtime_go_grpc//problem",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
    ],
)

go_test(
    name = "reservation_test",
    srcs = [
        "reservation_test.go",
        "update_test.go",
    ],
    embed = [":reservation"],
    deps = [
        "//internal/database/repository/repox",
        "//internal/service/generated/servicex",
        "//protobuf/generated/go/allocation/v1/allocationpbv1",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@org_golang_google_genproto//googleapis/type/interval",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
