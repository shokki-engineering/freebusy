load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reservation",
    srcs = [
        "hold.go",
        "reschedule.go",
        "reservation.go",
        "store.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy/internal/service/reservation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/database/repository/repox",
        "//internal/runtime/rpc",
        "//internal/types",
        "//protobuf/generated/go/allocation/v1/allocationpbv1",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "reservation_test",
    srcs = ["reservation_test.go"],
    embed = [":reservation"],
    deps = [
        "//internal/database/repository/repox",
        "//internal/types",
        "//protobuf/generated/go/allocation/v1/allocationpbv1",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@org_golang_google_genproto//googleapis/type/interval",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
