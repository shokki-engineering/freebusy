load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "db",
    srcs = [
        "store.go",
        "transition.go",
    ],
    importpath = "github.com/shokki-engineering/freebusy/internal/service/reservation/db",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/database",
        "//internal/database/gorm/filterx",
        "//internal/database/repository/freebusy/reservation",
        "//internal/database/repository/repox",
        "//internal/service/reservation",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "db_test",
    srcs = ["live_test.go"],
    embed = [":db"],
    deps = [
        "//internal/database",
        "//internal/database/gorm/rfc/resource",
        "//internal/database/hasura/freebusyql",
        "//internal/service/allocation",
        "//internal/service/allocation/db",
        "//internal/service/reservation",
        "//protobuf/generated/go/allocation/v1/allocationpbv1",
        "//protobuf/generated/go/reservation/v1/reservationpbv1",
        "//test/live",
        "@com_github_the_protobuf_project_runtime_go_ulid//:ulid",
        "@io_gorm_gorm//:gorm",
        "@io_gorm_gorm//clause",
        "@io_gorm_gorm//logger",
        "@org_golang_google_genproto//googleapis/type/interval",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
