---
kind: ObjectType
version: v1
definition:
  name: EventResources
  fields:
    - name: description
      type: String_1
    - name: displayName
      type: String_1
    - name: eventId
      type: String_1!
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: participantId
      type: String_1!
    - name: position
      type: String_1
    - name: resourceTypes
      type: "[String_1]"
  graphql:
    typeName: EventResources
    inputTypeName: EventResourcesInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: event_resources
      fieldMapping:
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        participantId:
          column:
            name: participant_id
        position:
          column:
            name: position
        resourceTypes:
          column:
            name: resource_types

---
kind: TypePermissions
version: v1
definition:
  typeName: EventResources
  permissions:
    - role: admin
      output:
        allowedFields:
          - description
          - displayName
          - eventId
          - icalUid
          - id
          - participantId
          - position
          - resourceTypes

---
kind: BooleanExpressionType
version: v1
definition:
  name: EventResourcesBoolExp
  operand:
    object:
      type: EventResources
      comparableFields:
        - fieldName: description
          booleanExpressionType: TextBoolExp
        - fieldName: displayName
          booleanExpressionType: TextBoolExp
        - fieldName: eventId
          booleanExpressionType: TextBoolExp
        - fieldName: icalUid
          booleanExpressionType: TextBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: participantId
          booleanExpressionType: TextBoolExp
        - fieldName: position
          booleanExpressionType: TextBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: EventResourcesBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: EventResourcesAggExp
  operand:
    object:
      aggregatedType: EventResources
      aggregatableFields:
        - fieldName: description
          aggregateExpression: TextAggExp
        - fieldName: displayName
          aggregateExpression: TextAggExp
        - fieldName: eventId
          aggregateExpression: TextAggExp
        - fieldName: icalUid
          aggregateExpression: TextAggExp
        - fieldName: id
          aggregateExpression: TextAggExp
        - fieldName: participantId
          aggregateExpression: TextAggExp
        - fieldName: position
          aggregateExpression: TextAggExp
  count:
    enable: true
    returnType: Int64
  graphql:
    selectTypeName: EventResourcesAggExp

---
kind: OrderByExpression
version: v1
definition:
  name: EventResourcesOrderByExp
  operand:
    object:
      orderedType: EventResources
      orderableFields:
        - fieldName: description
          orderByExpression: String1OrderByExp
        - fieldName: displayName
          orderByExpression: String1OrderByExp
        - fieldName: eventId
          orderByExpression: String1OrderByExp
        - fieldName: icalUid
          orderByExpression: String1OrderByExp
        - fieldName: id
          orderByExpression: String1OrderByExp
        - fieldName: participantId
          orderByExpression: String1OrderByExp
        - fieldName: position
          orderByExpression: String1OrderByExp
      orderableRelationships: []
  graphql:
    expressionTypeName: EventResourcesOrderByExp

---
kind: Model
version: v2
definition:
  name: EventResources
  objectType: EventResources
  source:
    dataConnectorName: freebusy_pgsql
    collection: event_resources
  filterExpressionType: EventResourcesBoolExp
  aggregateExpression: EventResourcesAggExp
  orderByExpression: EventResourcesOrderByExp
  graphql:
    selectMany:
      queryRootField: eventResources
      subscription:
        rootField: eventResources
    selectUniques:
      - queryRootField: eventResourcesById
        uniqueIdentifier:
          - id
        subscription:
          rootField: eventResourcesById
    filterInputTypeName: EventResourcesFilterInput
    aggregate:
      queryRootField: eventResourcesAggregate
      subscription:
        rootField: eventResourcesAggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: EventResources
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

