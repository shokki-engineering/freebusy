      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertJournalCalendarTimes
  outputType: InsertJournalCalendarTimesResponse!
  arguments:
    - name: objects
      type: "[InsertJournalCalendarTimesObject!]!"
    - name: postCheck
      type: JournalCalendarTimesBoolExp
      description: Insert permission predicate over the 'journal_calendar_times' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_journal_calendar_times
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertJournalCalendarTimes
    rootFieldKind: Mutation
  description: Insert into the journal_calendar_times table

---
kind: CommandPermissions
version: v1
