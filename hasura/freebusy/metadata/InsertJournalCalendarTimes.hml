---
kind: ObjectType
version: v1
definition:
  name: InsertJournalCalendarTimesObject
  fields:
    - name: date
      type: Date
    - name: dateTime
      type: Timestamptz
    - name: dateTimeZone
      type: String_1
    - name: id
      type: String_1!
    - name: valueCase
      type: String_1
  graphql:
    typeName: InsertJournalCalendarTimesObject
    inputTypeName: InsertJournalCalendarTimesObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_journal_calendar_times_object
      fieldMapping:
        date:
          column:
            name: date
        dateTime:
          column:
            name: date_time
        dateTimeZone:
          column:
            name: date_time_zone
        id:
          column:
            name: id
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertJournalCalendarTimesObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - date
          - dateTime
          - dateTimeZone
          - id
          - valueCase

---
kind: ObjectType
version: v1
definition:
