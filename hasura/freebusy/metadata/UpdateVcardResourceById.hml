kind: ObjectType
version: v1
definition:
  name: UpdateVcardResourceByIdUpdateColumns
  description: Update the columns of the 'vcard_resource' collection
  fields:
    - name: contactId
      type: UpdateColumnVcardResourceContactId
      description: Update the 'contact_id' column in the 'vcard_resource' collection.
    - name: createTime
      type: UpdateColumnVcardResourceCreateTime
      description: Update the 'create_time' column in the 'vcard_resource' collection.
    - name: deleteTime
      type: UpdateColumnVcardResourceDeleteTime
      description: Update the 'delete_time' column in the 'vcard_resource' collection.
    - name: etag
      type: UpdateColumnVcardResourceEtag
      description: Update the 'etag' column in the 'vcard_resource' collection.
    - name: expireTime
      type: UpdateColumnVcardResourceExpireTime
      description: Update the 'expire_time' column in the 'vcard_resource' collection.
    - name: id
      type: UpdateColumnVcardResourceId
      description: Update the 'id' column in the 'vcard_resource' collection.
    - name: name
      type: UpdateColumnVcardResourceName
      description: Update the 'name' column in the 'vcard_resource' collection.
    - name: uid
      type: UpdateColumnVcardResourceUid
      description: Update the 'uid' column in the 'vcard_resource' collection.
    - name: updateTime
      type: UpdateColumnVcardResourceUpdateTime
      description: Update the 'update_time' column in the 'vcard_resource' collection.
    - name: vcardCreateTime
      type: UpdateColumnVcardResourceVcardCreateTime
      description: Update the 'vcard_create_time' column in the 'vcard_resource' collection.
    - name: vcardUid
      type: UpdateColumnVcardResourceVcardUid
      description: Update the 'vcard_uid' column in the 'vcard_resource' collection.
  graphql:
    typeName: UpdateVcardResourceByIdUpdateColumns
    inputTypeName: UpdateVcardResourceByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_resource_by_id_update_columns
      fieldMapping:
        contactId:
          column:
            name: contact_id
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        id:
          column:
            name: id
        name:
          column:
            name: name
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time
        vcardCreateTime:
          column:
            name: vcard_create_time
        vcardUid:
          column:
            name: vcard_uid

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateVcardResourceByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - contactId
          - createTime
          - deleteTime
          - etag
          - expireTime
          - id
          - name
          - uid
          - updateTime
          - vcardCreateTime
          - vcardUid

