  outputType: UpdateVcardResourceByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardResourceBoolExp
      description: Update permission post-condition predicate over the
        'vcard_resource' collection
    - name: preCheck
      type: VcardResourceBoolExp
      description: Update permission pre-condition predicate over the 'vcard_resource'
        collection
    - name: updateColumns
      type: UpdateVcardResourceByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_vcard_resource_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: updateVcardResourceById
    rootFieldKind: Mutation
  description: Update any row on the 'vcard_resource' collection using the 'id' key

