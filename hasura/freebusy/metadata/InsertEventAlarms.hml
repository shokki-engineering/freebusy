---
kind: ObjectType
version: v1
definition:
  name: InsertEventAlarmsObject
  fields:
    - name: acknowledgedTime
      type: Timestamptz
    - name: action
      type: String_1
    - name: description
      type: String_1
    - name: eventId
      type: String_1!
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: proximity
      type: String_1
    - name: repeatCount
      type: Int32
    - name: repeatInterval
      type: String_1
    - name: snoozedAlarmUid
      type: String_1
    - name: summary
      type: String_1
    - name: triggerCase
      type: String_1
    - name: triggerOffset
      type: String_1
    - name: triggerRelation
      type: String_1
    - name: triggerTime
      type: Timestamptz
  graphql:
    typeName: InsertEventAlarmsObject
    inputTypeName: InsertEventAlarmsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_alarms_object
      fieldMapping:
        acknowledgedTime:
          column:
            name: acknowledged_time
        action:
          column:
            name: action
        description:
          column:
            name: description
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        proximity:
          column:
            name: proximity
        repeatCount:
          column:
            name: repeat_count
        repeatInterval:
          column:
            name: repeat_interval
        snoozedAlarmUid:
          column:
            name: snoozed_alarm_uid
        summary:
          column:
            name: summary
        triggerCase:
          column:
            name: trigger_case
        triggerOffset:
          column:
            name: trigger_offset
        triggerRelation:
          column:
            name: trigger_relation
        triggerTime:
          column:
            name: trigger_time

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventAlarmsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - acknowledgedTime
          - action
          - description
          - eventId
          - icalUid
          - id
          - proximity
          - repeatCount
          - repeatInterval
          - snoozedAlarmUid
          - summary
          - triggerCase
          - triggerOffset
          - triggerRelation
          - triggerTime

---
kind: ObjectType
version: v1
definition:
  name: InsertEventAlarmsResponse
  description: Responses from the 'insert_event_alarms' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventAlarms!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertEventAlarmsResponse
    inputTypeName: InsertEventAlarmsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_alarms_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventAlarmsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventAlarms
  outputType: InsertEventAlarmsResponse!
  arguments:
    - name: objects
      type: "[InsertEventAlarmsObject!]!"
    - name: postCheck
      type: EventAlarmsBoolExp
      description: Insert permission predicate over the 'event_alarms' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_alarms
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertEventAlarms
    rootFieldKind: Mutation
  description: Insert into the event_alarms table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventAlarms
  permissions:
    - role: admin
      allowExecution: true

