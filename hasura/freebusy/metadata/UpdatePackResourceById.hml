    - name: deleteTime
      type: UpdateColumnPackResourceDeleteTime
      description: Update the 'delete_time' column in the 'pack_resource' collection.
    - name: etag
      type: UpdateColumnPackResourceEtag
      description: Update the 'etag' column in the 'pack_resource' collection.
    - name: expireTime
      type: UpdateColumnPackResourceExpireTime
      description: Update the 'expire_time' column in the 'pack_resource' collection.
    - name: id
      type: UpdateColumnPackResourceId
      description: Update the 'id' column in the 'pack_resource' collection.
    - name: name
      type: UpdateColumnPackResourceName
      description: Update the 'name' column in the 'pack_resource' collection.
    - name: resolved
      type: UpdateColumnPackResourceResolved
      description: Update the 'resolved' column in the 'pack_resource' collection.
    - name: uid
      type: UpdateColumnPackResourceUid
      description: Update the 'uid' column in the 'pack_resource' collection.
    - name: updateTime
      type: UpdateColumnPackResourceUpdateTime
      description: Update the 'update_time' column in the 'pack_resource' collection.
  graphql:
    typeName: UpdatePackResourceByIdUpdateColumns
    inputTypeName: UpdatePackResourceByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_pack_resource_by_id_update_columns
      fieldMapping:
        baseVersion:
          column:
            name: base_version
        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        id:
          column:
            name: id
        name:
          column:
            name: name
        resolved:
          column:
            name: resolved
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

