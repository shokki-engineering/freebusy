version: v1
definition:
  name: UpdateVcardNamesById
  outputType: UpdateVcardNamesByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: VcardNamesBoolExp
      description: Update permission post-condition predicate over the 'vcard_names'
        collection
    - name: preCheck
