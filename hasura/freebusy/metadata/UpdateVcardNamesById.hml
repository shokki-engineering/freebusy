---
kind: ObjectType
version: v1
definition:
  name: UpdateVcardNamesByIdUpdateColumns
  description: Update the columns of the 'vcard_names' collection
  fields:
    - name: familyName
      type: UpdateColumnVcardNamesFamilyName
      description: Update the 'family_name' column in the 'vcard_names' collection.
    - name: generations
      type: UpdateColumnVcardNamesGenerations
      description: Update the 'generations' column in the 'vcard_names' collection.
    - name: givenName
      type: UpdateColumnVcardNamesGivenName
      description: Update the 'given_name' column in the 'vcard_names' collection.
    - name: honorificPrefixes
      type: UpdateColumnVcardNamesHonorificPrefixes
      description: Update the 'honorific_prefixes' column in the 'vcard_names' collection.
    - name: honorificSuffixes
      type: UpdateColumnVcardNamesHonorificSuffixes
      description: Update the 'honorific_suffixes' column in the 'vcard_names' collection.
    - name: id
      type: UpdateColumnVcardNamesId
      description: Update the 'id' column in the 'vcard_names' collection.
    - name: middleNames
      type: UpdateColumnVcardNamesMiddleNames
      description: Update the 'middle_names' column in the 'vcard_names' collection.
    - name: phonetic
      type: UpdateColumnVcardNamesPhonetic
      description: Update the 'phonetic' column in the 'vcard_names' collection.
    - name: script
      type: UpdateColumnVcardNamesScript
      description: Update the 'script' column in the 'vcard_names' collection.
    - name: secondarySurnames
      type: UpdateColumnVcardNamesSecondarySurnames
      description: Update the 'secondary_surnames' column in the 'vcard_names' collection.
  graphql:
    typeName: UpdateVcardNamesByIdUpdateColumns
    inputTypeName: UpdateVcardNamesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_vcard_names_by_id_update_columns
      fieldMapping:
        familyName:
          column:
            name: family_name
        generations:
          column:
            name: generations
        givenName:
          column:
            name: given_name
        honorificPrefixes:
          column:
            name: honorific_prefixes
        honorificSuffixes:
          column:
            name: honorific_suffixes
        id:
          column:
            name: id
        middleNames:
          column:
            name: middle_names
        phonetic:
          column:
            name: phonetic
        script:
          column:
            name: script
        secondarySurnames:
          column:
            name: secondary_surnames

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateVcardNamesByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - familyName
          - generations
          - givenName
          - honorificPrefixes
          - honorificSuffixes
          - id
          - middleNames
          - phonetic
          - script
          - secondarySurnames

