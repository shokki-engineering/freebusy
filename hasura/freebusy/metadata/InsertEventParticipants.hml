    - name: description
      type: String_1
    - name: eventId
      type: String_1!
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: participantTypes
      type: String_1!
    - name: position
      type: String_1
    - name: summary
      type: String_1
    - name: url
      type: String_1
  graphql:
    typeName: InsertEventParticipantsObject
    inputTypeName: InsertEventParticipantsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_participants_object
      fieldMapping:
        calendarAddress:
          column:
            name: calendar_address
        description:
          column:
            name: description
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        participantTypes:
          column:
            name: participant_types
        position:
          column:
            name: position
        summary:
          column:
            name: summary
        url:
          column:
            name: url

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventParticipantsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - calendarAddress
          - description
          - eventId
          - icalUid
          - id
          - participantTypes
          - position
          - summary
          - url

---
kind: ObjectType
version: v1
definition:
  name: InsertEventParticipantsResponse
  description: Responses from the 'insert_event_participants' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventParticipants!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertEventParticipantsResponse
    inputTypeName: InsertEventParticipantsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_participants_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventParticipantsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventParticipants
  outputType: InsertEventParticipantsResponse!
  arguments:
    - name: objects
      type: "[InsertEventParticipantsObject!]!"
    - name: postCheck
      type: EventParticipantsBoolExp
      description: Insert permission predicate over the 'event_participants' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_participants
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertEventParticipants
    rootFieldKind: Mutation
  description: Insert into the event_participants table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventParticipants
  permissions:
    - role: admin
      allowExecution: true

