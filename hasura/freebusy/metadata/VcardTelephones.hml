---
kind: ObjectType
version: v1
definition:
  name: VcardTelephones
  fields:
    - name: contactId
      type: String_1!
    - name: features
      type: String_1
    - name: id
      type: String_1!
    - name: pref
      type: Int32
    - name: text
      type: String_1
    - name: types
      type: String_1
    - name: uri
      type: String_1
    - name: valueCase
      type: String_1
  graphql:
    typeName: VcardTelephones
    inputTypeName: VcardTelephonesInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: vcard_telephones
      fieldMapping:
        contactId:
          column:
            name: contact_id
        features:
          column:
            name: features
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        text:
          column:
            name: text
        types:
          column:
            name: types
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
