        - fieldName: uri
          booleanExpressionType: TextBoolExp
        - fieldName: valueCase
          booleanExpressionType: TextBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
