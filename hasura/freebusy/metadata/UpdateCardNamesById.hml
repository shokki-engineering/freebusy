---
kind: Command
version: v1
definition:
  name: UpdateCardNamesById
  outputType: UpdateCardNamesByIdResponse!
  arguments:
    - name: keyId
      type: String_1!
    - name: postCheck
      type: CardNamesBoolExp
      description: Update permission post-condition predicate over the 'card_names'
        collection
    - name: preCheck
      type: CardNamesBoolExp
      description: Update permission pre-condition predicate over the 'card_names'
        collection
    - name: updateColumns
      type: UpdateCardNamesByIdUpdateColumns!
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: update_card_names_by_id
    argumentMapping:
      keyId: key_id
      postCheck: post_check
      preCheck: pre_check
      updateColumns: update_columns
  graphql:
    rootFieldName: updateCardNamesById
    rootFieldKind: Mutation
  description: Update any row on the 'card_names' collection using the 'id' key

---
kind: CommandPermissions
version: v1
