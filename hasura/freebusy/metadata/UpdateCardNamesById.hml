---
kind: ObjectType
version: v1
definition:
  name: UpdateCardNamesByIdUpdateColumns
  description: Update the columns of the 'card_names' collection
  fields:
    - name: defaultSeparator
      type: UpdateColumnCardNamesDefaultSeparator
      description: Update the 'default_separator' column in the 'card_names' collection.
    - name: displayName
      type: UpdateColumnCardNamesDisplayName
      description: Update the 'display_name' column in the 'card_names' collection.
    - name: id
      type: UpdateColumnCardNamesId
      description: Update the 'id' column in the 'card_names' collection.
    - name: isOrdered
      type: UpdateColumnCardNamesIsOrdered
      description: Update the 'is_ordered' column in the 'card_names' collection.
    - name: phoneticScript
      type: UpdateColumnCardNamesPhoneticScript
      description: Update the 'phonetic_script' column in the 'card_names' collection.
    - name: phoneticSystem
      type: UpdateColumnCardNamesPhoneticSystem
      description: Update the 'phonetic_system' column in the 'card_names' collection.
    - name: sortAs
      type: UpdateColumnCardNamesSortAs
      description: Update the 'sort_as' column in the 'card_names' collection.
  graphql:
    typeName: UpdateCardNamesByIdUpdateColumns
    inputTypeName: UpdateCardNamesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_card_names_by_id_update_columns
      fieldMapping:
        defaultSeparator:
          column:
            name: default_separator
        displayName:
          column:
            name: display_name
        id:
          column:
            name: id
        isOrdered:
          column:
            name: is_ordered
        phoneticScript:
          column:
            name: phonetic_script
        phoneticSystem:
          column:
            name: phonetic_system
        sortAs:
          column:
            name: sort_as

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateCardNamesByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - defaultSeparator
          - displayName
          - id
          - isOrdered
          - phoneticScript
          - phoneticSystem
          - sortAs

