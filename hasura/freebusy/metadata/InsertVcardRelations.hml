---
kind: ObjectType
version: v1
definition:
  name: InsertVcardRelationsObject
  fields:
    - name: contactId
      type: String_1!
    - name: id
      type: String_1!
    - name: pref
      type: Int32
    - name: relationTypes
      type: String_1
    - name: text
      type: String_1
    - name: uri
      type: String_1
    - name: valueCase
      type: String_1
  graphql:
    typeName: InsertVcardRelationsObject
    inputTypeName: InsertVcardRelationsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_relations_object
      fieldMapping:
        contactId:
          column:
            name: contact_id
        id:
          column:
            name: id
        pref:
          column:
            name: pref
        relationTypes:
          column:
            name: relation_types
        text:
          column:
            name: text
        uri:
          column:
            name: uri
        valueCase:
          column:
            name: value_case

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardRelationsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - contactId
          - id
          - pref
          - relationTypes
          - text
          - uri
          - valueCase

---
kind: ObjectType
version: v1
definition:
  name: InsertVcardRelationsResponse
  description: Responses from the 'insert_vcard_relations' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[VcardRelations!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertVcardRelationsResponse
    inputTypeName: InsertVcardRelationsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_vcard_relations_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertVcardRelationsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertVcardRelations
  outputType: InsertVcardRelationsResponse!
  arguments:
    - name: objects
      type: "[InsertVcardRelationsObject!]!"
    - name: postCheck
      type: VcardRelationsBoolExp
      description: Insert permission predicate over the 'vcard_relations' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_vcard_relations
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertVcardRelations
    rootFieldKind: Mutation
  description: Insert into the vcard_relations table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertVcardRelations
  permissions:
    - role: admin
      allowExecution: true

