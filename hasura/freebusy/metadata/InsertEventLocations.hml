---
kind: ObjectType
version: v1
definition:
  name: InsertEventLocationsObject
  fields:
    - name: description
      type: String_1
    - name: displayName
      type: String_1
    - name: eventId
      type: String_1!
    - name: icalUid
      type: String_1
    - name: id
      type: String_1!
    - name: locationTypes
      type: "[String_1]"
    - name: participantId
      type: String_1!
    - name: position
      type: String_1
  graphql:
    typeName: InsertEventLocationsObject
    inputTypeName: InsertEventLocationsObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_locations_object
      fieldMapping:
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        locationTypes:
          column:
            name: location_types
        participantId:
          column:
            name: participant_id
        position:
          column:
            name: position

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventLocationsObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - description
          - displayName
          - eventId
          - icalUid
          - id
          - locationTypes
          - participantId
          - position

---
kind: ObjectType
version: v1
definition:
  name: InsertEventLocationsResponse
  description: Responses from the 'insert_event_locations' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[EventLocations!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertEventLocationsResponse
    inputTypeName: InsertEventLocationsResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_event_locations_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertEventLocationsResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertEventLocations
  outputType: InsertEventLocationsResponse!
  arguments:
    - name: objects
      type: "[InsertEventLocationsObject!]!"
    - name: postCheck
      type: EventLocationsBoolExp
      description: Insert permission predicate over the 'event_locations' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_event_locations
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertEventLocations
    rootFieldKind: Mutation
  description: Insert into the event_locations table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertEventLocations
  permissions:
    - role: admin
      allowExecution: true

