---
kind: ObjectType
version: v1
definition:
  name: UserAddress
  fields:
    - name: attributeType
      type: String_1
    - name: fullAddress
      type: String_1
    - name: id
      type: String_1!
    - name: locality
      type: String_1
    - name: postalCode
      type: String_1
    - name: primary
      type: Boolean_1
    - name: region
      type: String_1
    - name: regionCode
      type: String_1
    - name: streetAddress
      type: String_1
    - name: userId
      type: String_1!
  graphql:
    typeName: UserAddress
    inputTypeName: UserAddressInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: user_address
      fieldMapping:
        attributeType:
          column:
            name: attribute_type
        fullAddress:
          column:
            name: full_address
        id:
          column:
            name: id
        locality:
          column:
            name: locality
        postalCode:
          column:
            name: postal_code
        primary:
          column:
            name: primary
        region:
          column:
            name: region
        regionCode:
          column:
            name: region_code
        streetAddress:
          column:
            name: street_address
        userId:
          column:
            name: user_id

---
kind: TypePermissions
version: v1
definition:
  typeName: UserAddress
  permissions:
    - role: admin
      output:
        allowedFields:
          - attributeType
          - fullAddress
          - id
          - locality
          - postalCode
          - primary
          - region
          - regionCode
          - streetAddress
          - userId

---
kind: BooleanExpressionType
version: v1
definition:
  name: UserAddressBoolExp
  operand:
    object:
      type: UserAddress
      comparableFields:
        - fieldName: attributeType
          booleanExpressionType: TextBoolExp
        - fieldName: fullAddress
          booleanExpressionType: TextBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: locality
          booleanExpressionType: TextBoolExp
        - fieldName: postalCode
          booleanExpressionType: TextBoolExp
        - fieldName: primary
          booleanExpressionType: BoolBoolExp
        - fieldName: region
          booleanExpressionType: TextBoolExp
        - fieldName: regionCode
          booleanExpressionType: TextBoolExp
        - fieldName: streetAddress
          booleanExpressionType: TextBoolExp
        - fieldName: userId
          booleanExpressionType: TextBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: UserAddressBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: UserAddressAggExp
  operand:
    object:
      aggregatedType: UserAddress
      aggregatableFields:
        - fieldName: attributeType
          aggregateExpression: TextAggExp
        - fieldName: fullAddress
