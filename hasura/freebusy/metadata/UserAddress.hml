---
kind: Model
version: v2
definition:
  name: UserAddress
  objectType: UserAddress
  source:
    dataConnectorName: freebusy_pgsql
    collection: user_address
  filterExpressionType: UserAddressBoolExp
  aggregateExpression: UserAddressAggExp
  orderByExpression: UserAddressOrderByExp
  graphql:
    selectMany:
      queryRootField: userAddress
      subscription:
        rootField: userAddress
    selectUniques:
