            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertReservationResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertReservationResource
  outputType: InsertReservationResourceResponse!
  arguments:
    - name: objects
      type: "[InsertReservationResourceObject!]!"
    - name: postCheck
      type: ReservationResourceBoolExp
      description: Insert permission predicate over the 'reservation_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_reservation_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertReservationResource
    rootFieldKind: Mutation
  description: Insert into the reservation_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertReservationResource
  permissions:
    - role: admin
      allowExecution: true

