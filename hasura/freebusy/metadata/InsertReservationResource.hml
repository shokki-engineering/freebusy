---
kind: ObjectType
version: v1
definition:
  name: InsertReservationResourceResponse
  description: Responses from the 'insert_reservation_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[ReservationResource!]!"
      description: Data from rows affected by the mutation
  graphql:
