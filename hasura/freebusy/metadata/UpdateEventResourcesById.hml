---
kind: ObjectType
version: v1
definition:
  name: UpdateEventResourcesByIdUpdateColumns
  description: Update the columns of the 'event_resources' collection
  fields:
    - name: description
      type: UpdateColumnEventResourcesDescription
      description: Update the 'description' column in the 'event_resources' collection.
    - name: displayName
      type: UpdateColumnEventResourcesDisplayName
      description: Update the 'display_name' column in the 'event_resources' collection.
    - name: eventId
      type: UpdateColumnEventResourcesEventId
      description: Update the 'event_id' column in the 'event_resources' collection.
    - name: icalUid
      type: UpdateColumnEventResourcesIcalUid
      description: Update the 'ical_uid' column in the 'event_resources' collection.
    - name: id
      type: UpdateColumnEventResourcesId
      description: Update the 'id' column in the 'event_resources' collection.
    - name: participantId
      type: UpdateColumnEventResourcesParticipantId
      description: Update the 'participant_id' column in the 'event_resources' collection.
    - name: position
      type: UpdateColumnEventResourcesPosition
      description: Update the 'position' column in the 'event_resources' collection.
    - name: resourceTypes
      type: UpdateColumnEventResourcesResourceTypes
      description: Update the 'resource_types' column in the 'event_resources' collection.
  graphql:
    typeName: UpdateEventResourcesByIdUpdateColumns
    inputTypeName: UpdateEventResourcesByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: update_event_resources_by_id_update_columns
      fieldMapping:
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        eventId:
          column:
            name: event_id
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        participantId:
          column:
            name: participant_id
        position:
          column:
            name: position
        resourceTypes:
          column:
            name: resource_types

---
kind: TypePermissions
version: v1
definition:
  typeName: UpdateEventResourcesByIdUpdateColumns
  permissions:
    - role: admin
      output:
        allowedFields:
          - description
          - displayName
          - eventId
          - icalUid
          - id
          - participantId
          - position
          - resourceTypes

