        createTime:
          column:
            name: create_time
        deleteTime:
          column:
            name: delete_time
        description:
          column:
            name: description
        displayName:
          column:
            name: display_name
        etag:
          column:
            name: etag
        expireTime:
          column:
            name: expire_time
        icalUid:
          column:
            name: ical_uid
        id:
          column:
            name: id
        name:
          column:
            name: name
        organizationalUnit:
          column:
            name: organizational_unit
        position:
          column:
