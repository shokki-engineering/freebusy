---
kind: ObjectType
version: v1
definition:
  name: InsertMembershipResourceObject
  fields:
    - name: createTime
      type: Timestamptz!
    - name: etag
      type: String_1
    - name: id
      type: String_1!
    - name: ldapGroupId
      type: String_1!
    - name: member
      type: String_1!
    - name: name
      type: String_1!
    - name: role
      type: String_1
    - name: uid
      type: String_1
    - name: updateTime
      type: Timestamptz!
  graphql:
    typeName: InsertMembershipResourceObject
    inputTypeName: InsertMembershipResourceObjectInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_membership_resource_object
      fieldMapping:
        createTime:
          column:
            name: create_time
        etag:
          column:
            name: etag
        id:
          column:
            name: id
        ldapGroupId:
          column:
            name: ldap_group_id
        member:
          column:
            name: member
        name:
          column:
            name: name
        role:
          column:
            name: role
        uid:
          column:
            name: uid
        updateTime:
          column:
            name: update_time

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertMembershipResourceObject
  permissions:
    - role: admin
      output:
        allowedFields:
          - createTime
          - etag
          - id
          - ldapGroupId
          - member
          - name
          - role
          - uid
          - updateTime

---
kind: ObjectType
version: v1
definition:
  name: InsertMembershipResourceResponse
  description: Responses from the 'insert_membership_resource' procedure
  fields:
    - name: affectedRows
      type: Int32!
      description: The number of rows affected by the mutation
    - name: returning
      type: "[MembershipResource!]!"
      description: Data from rows affected by the mutation
  graphql:
    typeName: InsertMembershipResourceResponse
    inputTypeName: InsertMembershipResourceResponseInput
  dataConnectorTypeMapping:
    - dataConnectorName: freebusy_pgsql
      dataConnectorObjectType: insert_membership_resource_response
      fieldMapping:
        affectedRows:
          column:
            name: affected_rows
        returning:
          column:
            name: returning

---
kind: TypePermissions
version: v1
definition:
  typeName: InsertMembershipResourceResponse
  permissions:
    - role: admin
      output:
        allowedFields:
          - affectedRows
          - returning

---
kind: Command
version: v1
definition:
  name: InsertMembershipResource
  outputType: InsertMembershipResourceResponse!
  arguments:
    - name: objects
      type: "[InsertMembershipResourceObject!]!"
    - name: postCheck
      type: MembershipResourceBoolExp
      description: Insert permission predicate over the 'membership_resource' collection
  source:
    dataConnectorName: freebusy_pgsql
    dataConnectorCommand:
      procedure: insert_membership_resource
    argumentMapping:
      objects: objects
      postCheck: post_check
  graphql:
    rootFieldName: insertMembershipResource
    rootFieldKind: Mutation
  description: Insert into the membership_resource table

---
kind: CommandPermissions
version: v1
definition:
  commandName: InsertMembershipResource
  permissions:
    - role: admin
      allowExecution: true

