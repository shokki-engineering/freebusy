# The connector's settings for local development and CI: copy to .env.
#
# The token is not a secret. The connector listens only inside the local
# Docker network, and the committed engine build (engine/build) embeds this
# same value -- which is what lets CI run the engine without a Hasura login.
# Rebuild with `just hasura regen` after changing anything below.
FREEBUSY_FREEBUSY_PGSQL_CONNECTION_URI="postgresql://postgres:postgrespassword@local.hasura.dev:5432/freebusydb"
FREEBUSY_FREEBUSY_PGSQL_HASURA_CONNECTOR_PORT=9794
FREEBUSY_FREEBUSY_PGSQL_READ_URL="http://local.hasura.dev:9794"
FREEBUSY_FREEBUSY_PGSQL_WRITE_URL="http://local.hasura.dev:9794"
FREEBUSY_FREEBUSY_PGSQL_HASURA_SERVICE_TOKEN_SECRET="freebusy-local-connector"
FREEBUSY_FREEBUSY_PGSQL_AUTHORIZATION_HEADER="Bearer freebusy-local-connector"
FREEBUSY_FREEBUSY_PGSQL_OTEL_EXPORTER_OTLP_ENDPOINT="http://local.hasura.dev:4317"
FREEBUSY_FREEBUSY_PGSQL_OTEL_SERVICE_NAME="freebusy_freebusy_pgsql"
